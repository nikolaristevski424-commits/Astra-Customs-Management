# =============================================================
# This file is the PRIMARY way to configure the bot. Fill this
# out and the bot works with zero /setup commands. Anything you
# leave blank falls back to a safe default; anything you later
# change here takes effect on next restart UNLESS it's also been
# explicitly set with /setup (a /setup change always wins over
# .env — see the README).
# =============================================================

# ---- Discord (required) ----
BOT_TOKEN=your_bot_token_here
CLIENT_ID=your_application_id_here
# Only needed for `node deploy-commands.js` (guild/instant mode, no --global flag)
GUILD_ID=your_test_server_id_here

# ---- Executive team (hardcoded on purpose — not editable from Discord) ----
# Comma-separated Discord role IDs and/or user IDs allowed to approve/pay
# payout requests and run /package setprice. Because this only lives in
# .env, a compromised or careless staff member with /setup access still
# can't grant themselves these powers.
EXECUTIVE_ROLE_IDS=
EXECUTIVE_USER_IDS=

# =============================================================
# Branding
# =============================================================
BRAND_NAME=Astra Customs
ACCENT_COLOR=
BANNER_URL=
FOOTER_URL=
PREFIX=-
GROUP_URL=
DISCORD_INVITE_URL=https://discord.gg/pap89wQJpk
WATERMARK_TEXT=ASTRA CUSTOMS 

# =============================================================
# Roles (comma-separated IDs where noted — a role can be in
# more than one of these)
# =============================================================
STAFF_ROLE_IDS=
MANAGER_ROLE_IDS=
HR_ROLE_IDS=
CREDIT_MANAGER_ROLE_IDS=
PAYOUT_MANAGER_ROLE_IDS=
# Can Accept/Deny /qc submissions:
QC_ROLE_IDS=1497416896600080445
# Can claim/close tickets. Leave blank to fall back to STAFF_ROLE_IDS.
TICKET_STAFF_ROLE_IDS=
WELCOME_ROLE_ID=
# Role allowed to accept or deny applications:
APPLICATION_REVIEWER_ROLE_ID=
# Role given after acceptance:
STAFF_APPLICATION_ACCEPT_ROLE_ID=
DESIGNER_APPLICATION_ACCEPT_ROLE_ID=
LOA_ROLE_ID=

# ---- Commission on orders ----
# % of the after-tax price a designer with that role keeps.
# Format: roleId:percent,roleId:percent,...
# Example below is pre-filled with the rates you gave:
COMMISSION_RATES=1497420135814791301:75,1497420194807808174:70,1497420310599700560:60,1497420258900709426:50
# Used for anyone with none of the roles above:
DEFAULT_COMMISSION_RATE=0

# =============================================================
# Channels (right-click a channel in Discord -> Copy Channel ID.
# Needs Developer Mode on: User Settings -> Advanced -> Developer Mode)
# =============================================================
TICKET_CATEGORY_ID=
ORDER_CATEGORY_ID=
TRANSCRIPT_CHANNEL_ID=
ORDER_LOG_CHANNEL_ID=
PURCHASE_LOG_CHANNEL_ID=
APPLICATIONS_CHANNEL_ID=
APPLICATION_RESULTS_CHANNEL_ID=
PROMOTIONS_CHANNEL_ID=
INFRACTIONS_CHANNEL_ID=
WELCOME_CHANNEL_ID=
DASHBOARD_CHANNEL_ID=
SHOWCASES_CHANNEL_ID=
ORDERING_CHANNEL_ID=
RULES_CHANNEL_ID=
ORDER_QUEUE_CHANNEL_ID=
ORDER_REQUESTS_CHANNEL_ID=
# Shared Forum/text channel. Each package or bundle request gets its own thread.
PACKAGE_BUNDLE_CHANNEL_ID=
# Legacy fallback; use PACKAGE_BUNDLE_CHANNEL_ID instead.
BUNDLE_REVIEW_CHANNEL_ID=
PACKAGE_REVIEW_CHANNEL_ID=
PAYOUT_REQUESTS_CHANNEL_ID=
QC_CHANNEL_ID=
LOA_CHANNEL_ID=
HONEYPOT_CHANNEL_ID=
AFFILIATIONS_CHANNEL_ID=
GIVEAWAY_CHANNEL_ID=

# =============================================================
# Roblox / payments
# =============================================================
ROBLOX_GROUP_ID=
ROBLOX_UNIVERSE_ID=
GAME_PLACE_ID=
BLOXLINK_GUILD_ID=
# Discord user ID of the person who manually delivers package files, if used.
PACKAGE_COLLECTOR_ID=
PACKAGE_COLLECTOR_TAG=
ORDER_COUNTER_START=1000
AUTO_CREDIT_PERCENT=0

# ---- Payment game pass pool ----
# Comma-separated Roblox game pass IDs the bot is allowed to edit the price
# of. /payment request auto-picks whichever one is free, sets its price,
# and hands back the link — no manual "which slot do I use" step, and no
# founder needs to touch anything. List as many as you want customers to
# be able to pay simultaneously (10 is plenty for most shops).
PAYMENT_GAMEPASS_IDS=

# ---- Roblox: game passes (Open Cloud API — recommended) ----
# Create a scoped API key at https://create.roblox.com/dashboard/credentials
# with the `game-pass:write` and `game-pass:read` scopes. Used by
# /payment request to update a game pass's price without a cookie.
ROBLOX_API_KEY=

# ---- Roblox: cookie (needed for purchase monitoring & payout auto-send) ----
# A .ROBLOSECURITY cookie for an account that can view group transactions
# (for purchase monitoring) and/or send group payouts. Never share this
# with anyone or commit it to source control.
# NOTE: also used as a fallback for /payment request if ROBLOX_API_KEY isn't set.
ROBLOX_COOKIE=

# ---- Bloxlink (optional — for @mentioning buyers/members automatically) ----
BLOXLINK_API_KEY=
