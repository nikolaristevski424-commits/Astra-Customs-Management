{
  "name": "design-shop-bot",
  "version": "1.0.0",
  "description": "All-in-one Discord management bot for a Roblox design/commission shop — orders, tickets, HR, payments, and more.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "deploy": "node deploy-commands.js",
    "deploy:global": "node deploy-commands.js --global",
    "test": "node --test tests/*.test.js",
    "audit": "npm audit --audit-level=moderate"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "jimp": "^1.6.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "overrides": {
    "zod": "^4.6.7",
    "follow-redirects": "1.16.2"
  }
}
